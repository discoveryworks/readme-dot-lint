# ABOUTME: Example environment configuration for readme-lint-service.
# ABOUTME: Copy this to .env and fill in your values.

# Server configuration
PORT=3515

# GitHub API configuration
# Optional: Increases rate limits from 60/hr to 5000/hr
# Get yours at: https://github.com/settings/tokens (needs no scopes for public repos)
GITHUB_TOKEN=

# Service configuration
# Base URL for the service (used in API responses)
BASE_URL=http://localhost:3515
